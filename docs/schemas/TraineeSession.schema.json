{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbrsx.ndrf.gov.in/schemas/TraineeSession.schema.json",
  "title": "TraineeSession",
  "description": "Lifecycle contract for CBRS-X simulation training sessions",
  "type": "object",
  "required": [
    "sessionId",
    "traineeId",
    "scenarioId",
    "startedAt",
    "passStatus"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique alphanumeric session identifier (e.g. sess-f4a7c891e23 or UUID)"
    },
    "traineeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Unique alphanumeric identifier of the responder"
    },
    "traineeName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255,
      "description": "Full formal name and rank of the responder"
    },
    "batchUnit": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "NDRF Battalion or Emergency Unit designation"
    },
    "scenarioId": {
      "type": "string",
      "description": "Unique primary key of the tactical scenario"
    },
    "scenarioCode": {
      "type": "string",
      "enum": ["CBRN-CHEM-01", "CBRN-RAD-02", "CBRN-BIO-03"],
      "description": "Standardized NDRF scenario classification code"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the session initialized"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the session concluded"
    },
    "finalScore": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Deterministic evaluation score (0-100)"
    },
    "passStatus": {
      "type": "string",
      "enum": ["PENDING", "IN_PROGRESS", "PASSED", "FAILED", "TIMED_OUT", "VOIDED"],
      "description": "Current evaluation lifecycle state"
    }
  },
  "additionalProperties": false
}
