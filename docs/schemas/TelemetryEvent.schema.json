{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cbrsx.ndrf.gov.in/schemas/TelemetryEvent.schema.json",
  "title": "TelemetryEvent",
  "description": "High-throughput real-time simulation event contract",
  "type": "object",
  "required": [
    "sessionId",
    "eventType",
    "timestamp"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Optional unique event UUID. Generated by backend if omitted."
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Foreign key reference to parent active session"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "ppe_donning_completed",
        "entered_hazard_zone_without_ppe",
        "leak_source_identified",
        "civilian_evacuated",
        "containment_completed",
        "decontamination_completed",
        "gas_concentration_sampled",
        "scba_low_air_warning",
        "session_voided"
      ],
      "description": "Standardized tactical telemetry action type"
    },
    "eventData": {
      "type": ["string", "null"],
      "description": "JSON-serialized metadata payload (e.g. {'correct': true, 'count': 1, 'ppm': 450.2})"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of action occurrence"
    }
  },
  "additionalProperties": false
}
