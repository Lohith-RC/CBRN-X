# ══════════════════════════════════════════════════════
# CBRS-X Environment Configuration
# Copy this file to .env and fill in values before deploying
# NEVER commit .env to version control
# ══════════════════════════════════════════════════════

# ── Database Credentials ──
# Generate a strong password: openssl rand -base64 32
POSTGRES_DB=cbrsx_db
POSTGRES_USER=cbrsx
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── API Key Authentication ──
# Generate with: openssl rand -hex 32
# Clients must send this in the X-API-Key header
CBRSX_API_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# ── CORS Origins ──
# Comma-separated list of allowed frontend origins
CBRSX_CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ── Spring Boot Profile ──
# Use 'prod' for production, 'dev' for development
SPRING_PROFILES_ACTIVE=prod
