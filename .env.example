# ══════════════════════════════════════════════════════
# CBRS-X Environment Configuration
# Copy this file to .env and fill in real values before deploying
# NEVER commit the real .env file to version control
# ══════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
# Generate a strong password: openssl rand -base64 32
POSTGRES_DB=cbrsx_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Spring Boot Backend ───────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Supabase direct connection (optional - overrides bundled Postgres):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<ref>.supabase.co:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<supabase-password>

# ── API Access Control & RBAC ─────────────────────────────
# Master API key (grants full access across Admin, Instructor, Simulation, and Trainee roles):
# Generate with: openssl rand -hex 32
CBRSX_API_KEY=CHANGE_ME_generate_a_long_random_key

# Optional: Role-scoped API keys for least-privilege deployments
CBRSX_INSTRUCTOR_KEY=
CBRSX_SIMULATION_KEY=
CBRSX_TRAINEE_KEY=

# Fail-closed mode (automatically true in 'prod' profile):
CBRSX_FAIL_CLOSED=true

# ── CORS Allowlist (comma-separated origins) ──────────────
CBRSX_CORS_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:5000

# ── Frontend build-time backend URL (dev proxies) ─────────
VITE_BACKEND_URL=http://localhost:8080
