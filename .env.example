# CBRS-X Environment Configuration
# Copy to .env and fill in real values before running docker compose up.
# NEVER commit the real .env file.

# ── Database ──────────────────────────────────────────────
POSTGRES_DB=cbrsx
POSTGRES_USER=cbrsx
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Spring Boot Backend ───────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Supabase direct connection (optional - overrides bundled Postgres):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<ref>.supabase.co:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<supabase-password>

# ── API Access Control ────────────────────────────────────
# When set, every /api/** request must carry header: X-API-Key <value>
# Leave empty ONLY for local development.
CBRSX_API_KEY=CHANGE_ME_generate_a_long_random_key

# ── CORS Allowlist (comma-separated origins) ──────────────
CBRSX_CORS_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:5000

# ── Frontend build-time backend URL (dev proxies) ─────────
VITE_BACKEND_URL=http://localhost:8080
