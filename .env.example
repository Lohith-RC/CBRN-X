# ══════════════════════════════════════════════════════
# CBRS-X Environment Configuration (Master Template)
# Copy this file to .env and configure for your target environment.
# NEVER commit the real .env file with production secrets.
# ══════════════════════════════════════════════════════

# ── 1. Database Configuration ──────────────────────────────
# In dev profile, backend uses in-memory H2 with PostgreSQL dialect if unset.
# In prod profile, backend connects to PostgreSQL / Supabase instance below.
POSTGRES_DB=cbrsx_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# Optional direct JDBC URL override (e.g., Supabase pooler / managed cloud instance):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<ref>.supabase.co:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<supabase-password>

# ── 2. Spring Boot Telemetry Backend ──────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── 3. API Access Control & Least-Privilege RBAC ──────────
# Master API key (grants full access across Admin, Instructor, Simulation, and Trainee roles):
# Generate with: openssl rand -hex 32
CBRSX_API_KEY=dev_api_key_cbrsx_demo_9841

# Optional: Role-scoped API keys for least-privilege deployments
CBRSX_INSTRUCTOR_KEY=
CBRSX_SIMULATION_KEY=
CBRSX_TRAINEE_KEY=

# Fail-closed security guard:
# Note: 'prod' profile always enforces fail-closed ON regardless of this setting.
CBRSX_FAIL_CLOSED=false

# ── 4. Initial Administrator Account ───────────────────────
# In dev profile defaults to admin / ndrf-admin-123.
# In prod profile, you MUST provide a non-empty strong password here.
CBRSX_ADMIN_USERNAME=admin
CBRSX_ADMIN_PASSWORD=ndrf-admin-123

# ── 5. Cryptographic Salt for Tamper-Evident Certificates ──
# Unique deployment salt used for SHA-256 certificate digest sealing.
# Generate with: openssl rand -hex 32
CBRSX_CRYPTO_SALT=CBRSX_DEV_SALT_NOT_FOR_PRODUCTION

# ── 6. CORS Allowlist (comma-separated origins) ───────────
CBRSX_CORS_ORIGINS=http://localhost:80,http://localhost:3000,http://localhost:5000,http://localhost:8080

# ── 7. Frontend Build-Time URL Configurations ─────────────
VITE_BACKEND_URL=http://localhost:8080
