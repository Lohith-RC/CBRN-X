# ==========================================
# CBRS-X (CBRN VR Training) .gitignore
# ==========================================

# 1. Environment & Production Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# 2. Java / Maven Backend Build Artifacts
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.log
.gradle/
build/
# Keep the Maven wrapper tracked (scripts + pinned distribution properties)
!backend/mvnw
!backend/mvnw.cmd
!backend/.mvn/
backend/.mvn/wrapper/*.jar

# 3. Node.js / React Build Artifacts & Dependencies
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.turbo/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Unity Build Artifacts, Cache & Temporary Files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*BurstDebugInformation_DoNotShip/
**/*BurstDebugInformation_DoNotShip/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb

# 5. OS & IDE Configuration Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
**/.idea/
.vscode/
**/.vscode/
.vs/
**/.vs/
.vsconfig
*.swp
*.bak
*.VC.db
*.opendb

# 6. Python Cache Artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 7. Large Media Assets / Video Recordings
#    Trainee-view beat videos are intentionally committable (see
#    trainee_view/public/videos/README.md); everything else stays ignored.
*.mp4
*.mov
*.avi
*.mkv
!trainee_view/public/videos/*.mp4

# 8. Local Reports & Generated Output (Keep docs/ tracking)
reports/
/reports/
reports/*
Bay03_Cinematic_Screenshots/
/Bay03_Cinematic_Screenshots/
reports/*.pdf
reports/*.html
docs/*.pdf
docs/*.html

# 9. Markdown & Documentation (root *.md ignored to keep the repo tidy;
#    README and everything under docs/ is always tracked)
*.md
!README.md
!docs/**/*.md

# 10. Process Logs
logs/
**/logs/
