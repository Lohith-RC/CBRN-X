# ==========================================
# CBRS-X (CBRN VR Training) .gitignore
# ==========================================

# 1. Java / Maven Backend Build Artifacts
backend/target/
backend/.mvn/
*.class
*.jar
*.war
*.ear
*.log

# 2. Node.js / React Dashboard Build Artifacts & Dependencies
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/npm-debug.log*
dashboard/yarn-debug.log*
dashboard/yarn-error.log*

# 3. Unity Build Artifacts & Temporary Files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# 4. Large Media Assets / Video Recordings (Keep repo lightweight)
*.mp4
*.mov
*.avi
*.mkv

# 5. OS & IDE Configuration Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.bak

# 6. Environment Files (Security & Credentials)
.env
.env.local
.env.development.local
.env.production.local
