# ==========================================
# CBRS-X (CBRN VR Training) .gitignore
# Enterprise Security & Clean Repository Policy
# ==========================================

# 1. Environment & Production Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.jks
*.p12
*.pfx
*.crt

# 2. Java / Maven Backend Build Artifacts
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.log
.gradle/
build/
# Keep Maven wrapper tracked (distribution properties & scripts)
!backend/mvnw
!backend/mvnw.cmd
!backend/.mvn/
backend/.mvn/wrapper/*.jar

# 3. Node.js / React Build Artifacts & Dependencies
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.turbo/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. Unity Build Artifacts, Cache & Temporary Files
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
*BurstDebugInformation_DoNotShip/
**/*BurstDebugInformation_DoNotShip/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb

# 5. OS & IDE Configuration Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
.idea/
**/.idea/
.vscode/
**/.vscode/
.vs/
**/.vs/
.vsconfig
*.swp
*.bak
*.VC.db
*.opendb

# 6. Python Cache Artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# 7. Large Media Assets / Video Recordings
#    Trainee-view beat videos are intentionally committable;
#    everything else stays ignored.
*.mp4
*.mov
*.avi
*.mkv
!trainee_view/public/videos/*.mp4

# 8. Local Reports & Generated Binary Artifacts
reports/
/reports/
reports/*
Bay03_Cinematic_Screenshots/
/Bay03_Cinematic_Screenshots/
reports/*.pdf
reports/*.html

# 9. Markdown & Documentation Governance
#    README, root docs, and subproject READMEs are always tracked.
*.md
!README.md
!docs/*.md
!docs/**/*.md
!trainee_view/public/videos/README.md

# 10. Process Logs
logs/
**/logs/
